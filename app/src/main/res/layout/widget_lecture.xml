<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Bar: Title & Batch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LECTURENOW"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_batch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_cyan"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="CP1"
            android:textColor="#0E7490"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- State & Live Chronometer Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_state_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● LIVE NOW"
            android:textColor="#4D7C0F"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Native Android Live Countdown Chronometer -->
        <Chronometer
            android:id="@+id/widget_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Subject & Room -->
    <TextView
        android:id="@+id/widget_subject_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="DS • Room 4111"
        android:textColor="#0F172A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Details / Sub-timer Text -->
    <TextView
        android:id="@+id/widget_time_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Ends in 45m • Faculty: PGV"
        android:textColor="#475569"
        android:textSize="12sp" />

    <!-- Next Lecture Sneak Peek -->
    <TextView
        android:id="@+id/widget_next_sneak_peek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Up next: DBMS in 8113 at 14:00"
        android:textColor="#0E7490"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
